+/// Prepend reproducible-path flags to each C/C++ compile set.
+/// OPENTUI_C_REMAP is supplied by the locked CI workflow.
+/// It is space-separated because each item is one compiler flag.
+/// When unset, upstream behavior is unchanged.
+/// The output slice is owned by the Zig build allocator.
+fn remapFlags(b: *std.Build, base: []const []const u8) []const []const u8 {
+    const raw = b.graph.environ_map.get("OPENTUI_C_REMAP") orelse return base;
+    var n: usize = 0;
+    var it = std.mem.tokenizeScalar(u8, raw, ' ');
+    while (it.next()) |_| n += 1;
+    const out = b.allocator.alloc([]const u8, n + base.len) catch @panic("OOM");
+    var i: usize = 0;
+    it.reset();
+    while (it.next()) |tok| : (i += 1) out[i] = tok;
+    @memcpy(out[n..], base);
+    return out;
+}
